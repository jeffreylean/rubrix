# Right and Backspace step over and remove one grapheme cluster.
# Line 1: the family is one 25-byte cluster, four people joined by
# ZWJs, from column 8.
caret 1:8
key right
expect carets 1 primary 1 1:33
key backspace
expect line 1 family  end
expect carets 1 primary 1 1:8
# Line 2: the accented e is an e and a 2-byte combining acute, from
# column 11.
caret 2:11
key right
expect carets 1 primary 1 2:14
key backspace
expect line 2 accent caf end
expect carets 1 primary 1 2:11
# Line 3: each CJK char is 3 bytes, from column 5.
caret 3:5
key right
expect carets 1 primary 1 3:8
key right
expect carets 1 primary 1 3:11
key right
expect carets 1 primary 1 3:14
key right
expect carets 1 primary 1 3:17
key backspace
expect line 3 cjk 你好世 end
expect carets 1 primary 1 3:14
key backspace
expect line 3 cjk 你好 end
expect carets 1 primary 1 3:11
key backspace
expect line 3 cjk 你 end
expect carets 1 primary 1 3:8
key backspace
expect line 3 cjk  end
expect carets 1 primary 1 3:5
