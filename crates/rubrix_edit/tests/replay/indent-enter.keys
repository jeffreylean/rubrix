# Enter starts the new line with the whitespace that starts the line
# above.
# Line 16 is indented with four spaces.
caret 16:1
key end
key enter
expect line 17 \s\s\s\s
expect carets 1 primary 1 17:5
expect line 16 \s\s\s\slet [_, r, g, b] = rgb.to_be_bytes();
# The file has no tab, so line 2, which is blank, gets one.
caret 2:1
type \tlet tab = 1;
key enter
expect line 3 \t
expect carets 1 primary 1 3:2
expect line 2 \tlet tab = 1;
