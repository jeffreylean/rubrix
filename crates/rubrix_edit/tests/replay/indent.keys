# Tab fills to the next 4-column stop at a caret, adds a tab at a
# caret on a tab-led line, and indents each line of a selection over
# several lines. Each Tab is one undo step that restores the carets.
# Line 16 starts with four spaces, so column 2 fills to column 4.
caret 16:3
key indent
expect line 16 \s\s\s\s\s\slet [_, r, g, b] = rgb.to_be_bytes();
expect carets 1 primary 1 16:5
expect undo-depth 1
key undo
expect line 16 \s\s\s\slet [_, r, g, b] = rgb.to_be_bytes();
expect carets 1 primary 1 16:3
expect undo-depth 0
# Lines 15 to 18 each gain four spaces at column 0.
select 15:1 18:2
key indent
expect line 15 \s\s\s\sfn hex(rgb: u32) -> Color {
expect line 16 \s\s\s\s\s\s\s\slet [_, r, g, b] = rgb.to_be_bytes();
expect line 17 \s\s\s\s\s\s\s\sColor::srgb_u8(r, g, b)
expect line 18 \s\s\s\s}
expect carets 1 primary 1 15:5..18:6
expect undo-depth 1
key undo
expect line 15 fn hex(rgb: u32) -> Color {
expect line 18 }
expect carets 1 primary 1 15:1..18:2
# Line 2 is blank. Once it starts with a tab, Tab at a caret adds a
# tab.
caret 2:1
type \tx
key indent
expect line 2 \tx\t
expect carets 1 primary 1 2:4
key undo
expect line 2 \tx
expect carets 1 primary 1 2:3
